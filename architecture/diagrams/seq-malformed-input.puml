@startuml seq-malformed-input
title Runtime: Malformed Input\n(Black hand has only 3 cards)

participant "stdin" as stdin
participant "cli" as cli
participant "parser" as parser
participant "stdout" as stdout

stdin -> cli : line = "Black: 2H 3D 5S  White: 2C 3H 4S 8C AH"

cli -> parser : parse_line(line)
parser -> parser : tokenise - Black hand yields only 3 cards
parser -> parser : raise ValueError("Black hand must contain exactly 5 cards")
parser --> cli : ValueError

cli -> cli : catch ValueError
cli -> stdout : "Error: invalid input – Black hand must contain exactly 5 cards."

@enduml
